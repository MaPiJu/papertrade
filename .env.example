# Copiez ce fichier en .env et remplissez-le. Ne commitez JAMAIS .env.

# --- Les deux wallets (clés privées EVM) ---------------------------------
# A porte la jambe LONG, B la jambe SHORT. Utilisez deux wallets dédiés au bot,
# avec uniquement les fonds que vous acceptez de perdre.
WALLET_A_PRIVATE_KEY=0x...
WALLET_B_PRIVATE_KEY=0x...

# Adresse de dépôt PaperTrade de chaque wallet (bouton "Deposit" sur papertrade.xyz).
# Le rééquilibrage y envoie les USDC depuis HyperCore. `python -m ptbot probe`
# affiche aussi celle renvoyée par l'API: vérifiez qu'elles sont identiques.
DEPOSIT_ADDRESS_A=0x...
DEPOSIT_ADDRESS_B=0x...

# --- Stratégie ------------------------------------------------------------
COIN=BTC                      # BTC ou ETH
# ladder (échelle) : la jambe qui perd LADDER_STEP_PCT est fermée (PAPER minté) et rouverte aussitôt,
# l'autre continue ; tout est fermé quand une jambe gagne LADDER_RESET_PCT. pair : les 2 jambes
# sont fermées ensemble dès que le prix a bougé de CLOSE_MOVE_PCT.
STRATEGY=ladder
# Long et short sur le wallet A (l'USDC de B y est transféré une fois, plus de rééquilibrage).
# Conseillé avec l'échelle et un petit capital. Demande le test --straddle (README, étape 8).
ONE_WALLET=false
LADDER_STEP_PCT=0.25          # le levier des jambes en découle (liquidation 0,15% au-delà)
LADDER_RESET_PCT=0            # 0 = calculé depuis l'émission pour rester 2% sous le plafond de coût
LADDER_MAX_LEVERAGE=1000

# --- Paire classique (STRATEGY=pair, ou échelle impossible faute de capital) ----
LEVERAGE=250
# Le notionnel minimum d'une position est lu dans /state/trading (1 000 $ aujourd'hui).
# Si MAX_LEVERAGE > LEVERAGE, le bot monte le levier juste assez pour rester au
# minimum quand les soldes baissent.
MAX_LEVERAGE=250
# Marge par jambe = ce qu'il faut pour ce notionnel au levier choisi (11 000 $ / 250 = 44 $).
# Si le plus petit solde ne suffit pas, le bot ouvre plus petit, tant que le minimum est respecté.
# 0 = utiliser tout le solde (MARGIN_FRACTION).
TARGET_NOTIONAL_USD=11000
CLOSE_MOVE_PCT=0.70           # ferme les 2 jambes quand le prix a bougé de 0,70%, sauf si la liquidation est plus proche :
LIQ_SAFETY_PCT=0.15           # toujours fermer au moins 0,15% avant le prix de liquidation (x250 : liquidation 0,35%, sortie 0,20%)
MARGIN_FRACTION=1.0           # part du plus petit solde utilisée comme marge par jambe
MAX_MARGIN_USD=0              # 0 = pas de plafond

# --- Rééquilibrage des USDC entre A et B -----------------------------------
REBALANCE_THRESHOLD_PCT=10    # rééquilibre si |A-B| / (A+B) dépasse 10%
MIN_REBALANCE_USD=11            # minimum 11: retraits et dépôts de 10 USDC mini, +1 USDC d'activation HyperCore

# --- Staking ----------------------------------------------------------------
STAKE_THRESHOLD_PAPER=1000    # stake tout le PAPER d'un wallet dès qu'il en a 1000

# --- Arrêt automatique (règle de rusk0f) --------------------------------------
MAX_COST_PER_1000_PAPER=7     # stop dès qu'un cycle coûte plus de 7 $ pour 1000 PAPER
COST_WINDOW=3                 # moyenne des 3 derniers cycles (1 = jugé cycle par cycle)

# --- Technique ---------------------------------------------------------------
USE_SESSION_KEY=true          # comme le site: une clé locale qui ne peut qu'ouvrir/fermer
OPEN_DEADLINE_S=120           # validité d'un ordre d'ouverture (à monter si le relayer est lent)
STATE_DIR=data
# PAPERTRADE_API=https://exchange.papertrade.xyz
# HYPEREVM_RPC=https://rpc.hyperliquid.xyz/evm
# HYPERLIQUID_API=https://api.hyperliquid.xyz
